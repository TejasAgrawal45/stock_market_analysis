# =====================================================================
# Financial News API Credentials & Configuration
# =====================================================================
# Copy this file to .env and insert your personal API key(s).
# If keys are omitted, the pipeline automatically falls back to live
# public financial RSS feeds (Yahoo Finance & Google News) without errors.

# Primary Financial News API: Finnhub (Free key at https://finnhub.io/)
FINNHUB_API_KEY=

# Optional Secondary API: Alpha Vantage (https://www.alphavantage.co/)
ALPHAVANTAGE_API_KEY=

# Optional NewsAPI: (https://newsapi.org/)
NEWS_API_KEY=

# Target Stock Ticker Symbol for Company-Specific News
STOCK_TICKER=AAPL
